# ==============================================================================
# JASUSS Production Environment Configuration Template — jasuss.tech
# Copy this template to .env.production or input these variables into your
# cloud deployment console (Render, Railway, Fly.io, or AWS).
# ==============================================================================

# Core Runtime Environment
ENVIRONMENT=production
LOG_LEVEL=INFO

# Domain & CORS Allow-List (Comma-separated origins permitted to reach API)
ALLOWED_ORIGINS=https://jasuss.tech,https://www.jasuss.tech,https://api.jasuss.tech

# Production Database (Managed PostgreSQL with SSL)
# Example: postgresql://user:password@hostname.oregon-postgres.render.com/ai_qa_db?sslmode=require
DATABASE_URL=postgresql://ai_qa_user:YOUR_POSTGRES_PASSWORD@YOUR_POSTGRES_HOST/ai_qa_db?sslmode=require

# Message Broker & Distributed Worker (Managed Redis for Celery)
# Example: rediss://default:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST.render.com:6379
REDIS_URL=rediss://default:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST:6379

# Google Gemini AI Synthesis (https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_PRODUCTION_GEMINI_API_KEY
AI_MODEL=gemini-2.5-flash

# Crawler & QA Engine Limits
QA_PIPELINE_TIMEOUT=1800
QA_MAX_PAGES_LIMIT=100
MAX_SCAN_DURATION=1800
MAX_PAGES=100
MAX_TEST_CASES=200
MAX_CONCURRENT_SCANS=5

# Supabase Authentication & Storage (https://supabase.com/)
NEXT_PUBLIC_SUPABASE_URL=https://xsrcksdtiymswfrlkhtf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
