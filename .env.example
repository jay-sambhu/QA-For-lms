# ==============================================================================
# JASUSS Environment Configuration Template (Powered by Nexus)
# Copy this file to .env and configure your local or production credentials.
# NEVER commit real secret keys or passwords to version control.
# ==============================================================================

# Core Application & Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL in production, SQLite in local dev)
DATABASE_URL=sqlite:///./qa_agent.db

# Message Broker & Distributed Worker (Redis for Celery)
REDIS_URL=redis://localhost:6379/0

# Google Gemini AI Synthesis (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash

# Crawler & QA Engine Limits
MAX_SCAN_DURATION=1800
MAX_PAGES=100
MAX_TEST_CASES=200
MAX_CONCURRENT_SCANS=5

# Optional: Supabase Authentication (https://supabase.com/)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional: Payment Gateways (Stripe, LemonSqueezy, Razorpay, PayPal)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_api_key
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
PAYPAL_CLIENT_ID=your_paypal_client_id
