# Copy to .env and fill in. NEVER commit .env
# Used by both `./start.sh` (local dev) and `docker compose` (DigitalOcean).

ENVIRONMENT=production
LOG_LEVEL=INFO

# --- Public address (docker compose / Caddy) ---
# Your domain for automatic HTTPS (DNS A record -> droplet IP), or :80 for IP-only HTTP
SITE_ADDRESS=:80
NEXT_PUBLIC_APP_URL=https://your-domain.example
# Comma-separated origins allowed to call the API (only needed if the API is
# reached from a different origin than the web app)
ALLOWED_ORIGINS=https://your-domain.example

# --- Database (compose runs Postgres; set a strong password) ---
POSTGRES_USER=jasuss
POSTGRES_DB=jasuss
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Local dev without Docker falls back to SQLite when DATABASE_URL is unset.
# DATABASE_URL=sqlite:///./qa_agent.db
# REDIS_URL=redis://localhost:6379/0

# --- Worker sizing (1 concurrent scan fits a 2 GB droplet) ---
WORKER_CONCURRENCY=1
WORKER_MEM_LIMIT=1g

# Comma-separated emails granted admin
ADMIN_EMAILS=
# Delete screenshots/intermediate scan files older than N days (0 = keep forever)
QA_ARTIFACT_RETENTION_DAYS=7
# Crawl fewer viewports to save RAM/time, e.g. "desktop"
# QA_VIEWPORTS=

# --- Security: keep false in production (blocks scanning private/internal IPs) ---
ALLOW_LOCAL_TARGETS=false

# --- AI (users bring their own keys; this is an optional server default) ---
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash

# --- Supabase auth & storage ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Billing (optional) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LEMONSQUEEZY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYPAL_WEBHOOK_SECRET=
LEMONSQUEEZY_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
