# SITE_ADDRESS: your domain (e.g. jasuss.tech) for automatic HTTPS,
# or ":80" to serve plain HTTP on the droplet IP.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# API traffic goes straight to FastAPI instead of through the Next.js proxy.
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /healthz {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}
}
