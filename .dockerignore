# Secrets — never bake into an image
.env
.env.*
web/.env*

# Python bytecode and environments
__pycache__/
*.py[cod]
*$py.class
*.venv*
.venv/
.venv312/
.pytest_cache/
.ruff_cache/

# Local databases, output, and artifacts
*.db
*.sqlite
*.sqlite3
results/
reports/
screenshots/
user_data/
scripts/*.log
scripts/.jasuss_pids
scratch/

# Web frontend (built from web/Dockerfile)
web/
node_modules/

# Docs and deploy config
docs/
*.md
deploy/

# Git & CI
.git/
.github/
.gitignore
.dockerignore
