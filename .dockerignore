# Secrets — never bake into an image
.env
.env.*
web/.env*

# Python bytecode and environments
__pycache__/
*.py[cod]
*$py.class
*.venv*
.venv/
.venv312/
.pytest_cache/
.ruff_cache/

# Tests & Test Configuration (exclude from production Docker build)
tests/
conftest.py
test_*.py
*_test.py
benchmarks/

# Local databases, output, and artifacts
*.db
*.sqlite
*.sqlite3
results/
reports/
screenshots/
user_data/
scripts/*.log
scripts/.jasuss_pids
scratch/

# Web frontend (built from web/Dockerfile)
web/
node_modules/

# Docs and agent tooling
docs/
*.md
.agent/
.agents/
.gsd/
.gemini/
adapters/
deploy/

# Git & CI
.git/
.github/
.gitignore
.dockerignore
